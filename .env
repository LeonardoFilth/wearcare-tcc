# ============================================================
#  WearCare — Variáveis de Ambiente
#
#  Como usar:
#    cp .env.example .env
#    Preencha os valores abaixo no .env
#    NUNCA commite o .env no Git
# ============================================================

# ── Servidor ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (URL do frontend) ────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Autenticação JWT ──────────────────────────────────────────
# Gere uma chave segura:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_LONGA_E_ALEATORIA
JWT_EXPIRES_IN=7d

# ── PostgreSQL ────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=wearcare
PGUSER=postgres
PGPASSWORD=1Shadow0tod0.

# ── MQTT ──────────────────────────────────────────────────────
# Broker público (desenvolvimento):
#   MQTT_URL=mqtt://broker.hivemq.com
# Broker EMQX Cloud com TLS (produção):
#   MQTT_URL=mqtts://SEU_BROKER.emqxsl.com
MQTT_URL=mqtt://broker.hivemq.com
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=wearcare_backend

# ── Notificações — Twilio SMS ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006

# ── Notificações — E-mail SMTP ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leoprogramador25@gmail.com
SMTP_PASS=1Shadow0tod0
SMTP_FROM=WearCare <leoprogramador25@gmail.com>
