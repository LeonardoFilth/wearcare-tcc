# ============================================================
#  WearCare — .gitignore
#  Protege credenciais e arquivos desnecessários no GitHub
# ============================================================

# ── SEGURANÇA: nunca versionar ──────────────────────────────
.env
.env.local
.env.*.local
secrets.h
*.pem
*.key
*.p12

# ── Dependências ────────────────────────────────────────────
node_modules/
.npm/

# ── Build ────────────────────────────────────────────────────
dist/
build/
.vite/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Sistema operacional ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editores ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp

# ── PostgreSQL dumps com dados reais ─────────────────────────
*.dump
*.sql.gz

# ── Arduino / PlatformIO ─────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
